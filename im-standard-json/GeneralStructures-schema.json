{
  "$id": "GeneralStructures-schema.json",
  "$schema": "https://json-schema.org/draft-07/schema",
  "description": "General (meta) information elements.\nUsed for Informationmodel, and other models",
  "version": "0.9",
  "type": "object",
  "components": {
    "schemas": {
      "AdditionalProperties": {
        "description": "additional properties (aka user defined properties udp) are any properties of an element added by the current modeller. They serve as an extension to the predfefined element properties.",
        "type": "object",
        "additionalProperties": {
          "type": [
            "integer",
            "string",
            "number",
            "array",
            "object",
            "boolean",
            "null"
          ]
        },
        "examples": [
          {
            "businessrule-id": 1134,
            "status": "over",
            "sources": [
              "a",
              "b",
              "c"
            ]
          },
          {
            "release-level": "published"
          },
          {
            "author": "Jon Doe"
          }
        ]
      },
      "Examples": {
        "description": "List of examplevalues for this entity, attribute, domain or relationship",
        "type": "array",
        "items": {
          "type": [
            "array",
            "object",
            "integer",
            "string",
            "number",
            "boolean"
          ]
        }
      },
      "BaseModelInfo": {
        "type": "object",
        "properties": {
          "modelname": {
            "description": "Name of the model. Unique in the environment of related models",
            "$ref": "GeneralTypes-schema.json#/components/$defs/Name"
          },
          "targetenvironment": {
            "description": "Name of environment, world of influence this model is applicable in.",
            "$ref": "GeneralTypes-schema.json#/components/$defs/Uri",
            "examples": [
              "https://mycompany.com/GutesProdukt",
              "urn:vse:CommonModel"
            ]
          },
          "description": {
            "description": "Information about the model, its origin, its applicable environment",
            "$ref": "GeneralTypes-schema.json#/components/$defs/SomeText"
          },
          "modeltype": {
            "type": "string",
            "enum": [
              "Meta model",
              "Information model",
              "Data model",
              "System model"
            ]
          },
          "datetimecreated": {
            "description": "Timestamp when this version of the model was generated",
            "type": "string",
            "format": "date-time",
            "examples": [
              "2024-11-11T13:04:1Z"
            ]
          },
          "modelversion": {
            "description": "Version number of the information model documented in this file",
            "$ref": "GeneralTypes-schema.json#/components/$defs/VersionNo",
            "examples": [
              "1.0.1",
              "0.9"
            ]
          },
          "origintool": {
            "description": "Name of the tool / environment this model was originally managed",
            "$ref": "GeneralTypes-schema.json#/components/$defs/Name",
            "examples": [
              "dataspot",
              "VisualParadigm",
              "SPOD"
            ]
          },
          "originref": {
            "description": "uri, directory, file where the origin is located",
            "type": "string",
            "examples": [
              "./myproject/ODM",
              "dataspot.io/web/foryou/"
            ]
          }
        },
        "required": [
          "modelname",
          "targetenvironment",
          "modelversion",
          "modeltype"
        ]
      }
    }
  }
}

<?xml version="1.0" encoding="UTF-8" ?>
<udp_library>
	<udp_groups>
		<group name="zoomlevel" id="9349CE74-2F47-B9E5-A332-69E5AF2255FF" />
		<group name="printlevel" id="3B8B1A0F-E04A-B3AC-18EE-B43F1EC1A761" />
	</udp_groups>
	<properties>
		<property name="minzoomlevel" dispalay_name="Minimal Zoom Level" type="Number" group_id="9349CE74-2F47-B9E5-A332-69E5AF2255FF" default_value="0">
		<description>
			<![CDATA[Minimum zoom level  (closest to reality) in which element is displayed]]>
		</description>
			<objects>
				<object class="oracle.dbtools.crest.model.design.logical.Attribute" visible="false" color="-1"/>
				<object class="oracle.dbtools.crest.model.design.logical.Entity" visible="true" color="-1"/>
				<object class="oracle.dbtools.crest.model.design.logical.Relation" visible="false" color="-1"/>
			</objects>
		</property>
		<property name="maxzoomlevel" dispalay_name="Maximum Zoom Level" type="Number" group_id="9349CE74-2F47-B9E5-A332-69E5AF2255FF" default_value="4">
		<description>
			<![CDATA[Maximum zoom level (Overvie, Entry-Point) in which element is displayed]]>
		</description>
			<objects>
				<object class="oracle.dbtools.crest.model.design.logical.Attribute" visible="false" color="-1"/>
				<object class="oracle.dbtools.crest.model.design.logical.Entity" visible="true" color="-1"/>
				<object class="oracle.dbtools.crest.model.design.logical.Relation" visible="false" color="-1"/>
			</objects>
		</property>
		<property name="isdescriptive" dispalay_name="Descriptive Attribute" type="List" group_id="9349CE74-2F47-B9E5-A332-69E5AF2255FF" default_value="FALSE">
		<description>
			<![CDATA[TRUE -&amp;amp;amp;amp;amp;gt; Attribute helps to understand Entity
FALSE -&amp;amp;amp;amp;amp;gt; Attribute is not important for understanding]]>
		</description>
			<objects>
				<object class="oracle.dbtools.crest.model.design.logical.Attribute" visible="false" color="-1"/>
			</objects>
			<list_of_values>
				<item value="FALSE" default="true"/>
				<item value="TRUE" default="false"/>
			</list_of_values>
		</property>
		<property name="publ_status" dispalay_name="" type="List" group_id="3B8B1A0F-E04A-B3AC-18EE-B43F1EC1A761" default_value="GTOP">
		<description>
			<![CDATA[DEV:  Development phase
DRAFT: not yet released
GTOP: good to print
PUBL: publishable]]>
		</description>
			<objects>
				<object class="oracle.dbtools.crest.model.design.logical.Attribute" visible="false" color="-1"/>
				<object class="oracle.dbtools.crest.model.design.relational.Column" visible="false" color="-1"/>
				<object class="oracle.dbtools.crest.model.design.logical.Entity" visible="false" color="-1"/>
				<object class="oracle.dbtools.crest.model.design.logical.Relation" visible="false" color="-1"/>
				<object class="oracle.dbtools.crest.model.design.relational.Table" visible="false" color="-1"/>
				<object class="oracle.dbtools.crest.model.design.relational.TableView" visible="false" color="-1"/>
			</objects>
			<list_of_values>
				<item value="DRAFT" default="false"/>
				<item value="GTOP" default="true"/>
				<item value="PUBL" default="false"/>
			</list_of_values>
		</property>
	</properties>
</udp_library>